{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.1.7",
  "description": "自然语言驱动的网页自动化 Agent：点击、输入、滚动、导航、提取。",
  "permissions": ["activeTab", "scripting", "tabs", "sidePanel", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/service-worker.js" },
  "action": { "default_title": "Browser Agent" },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "common/protocol.js",
        "content/snapshot.js",
        "content/locator.js",
        "content/executor.js",
        "content/main.js"
      ]
    }
  ]
}
